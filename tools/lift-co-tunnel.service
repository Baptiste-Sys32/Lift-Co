[Unit]
Description=Lift Co temporary HTTPS preview tunnel
After=network-online.target lift-co-web.service
Wants=network-online.target lift-co-web.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/lift-co
ExecStart=/home/ubuntu/lift-co/bin/cloudflared tunnel --no-autoupdate --protocol http2 --url http://127.0.0.1:80
Restart=always
RestartSec=10
MemoryMax=160M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
